# =============================================================================
# Szablon konfiguracji środowiska - PrestaShop 8.2.x (Mosquito - Moda Damska)
# Skopiuj ten plik do .env przed uruchomieniem: cp .env.example .env
# =============================================================================

# --- Konfiguracja Domowych Kontenerów i Domeny ---
PS_DOMAIN=localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443

# --- PrestaShop 8.2.x ---
PS_VERSION=8.2.0
PS_LANGUAGE=pl
PS_COUNTRY=PL
PS_FOLDER_ADMIN=admin_fashion
PS_ENABLE_SSL=1
PS_DEV_MODE=0

# --- Konto Administratora PrestaShop (tylko do inicjalizacji lokalnej) ---
ADMIN_MAIL=admin@mosquito.local
ADMIN_PASSWD=ChangeMe_StrongPassword123!

# --- Baza Danych (MariaDB / MySQL) ---
DB_SERVER=db
DB_PORT=3306
DB_NAME=prestashop
DB_USER=prestashop_user
DB_PASSWD=ChangeMe_DbPassword123!
DB_ROOT_PASSWD=ChangeMe_RootPassword123!
DB_PREFIX=ps_

# --- PrestaShop Webservice API (D2) ---
PRESTASHOP_API_KEY=ChangeMe_insert_api_key_here

# --- Poczta Testowa (Mailpit - W3) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Scraper (W2) ---
SCRAPER_BASE_URL=https://mosquito-sklep.pl
SCRAPER_RATE_LIMIT_RPS=2.0
SCRAPER_USER_AGENT="PrestaShopFashionBot/1.0 (Educational Project; Mosquito Shop; +https://github.com/)"
IMAGES_RELEASE_ARCHIVE_URL=https://github.com/Sk1pp3rr/prestoshop-dywany/releases/download/images-v1.0/images.zip

# --- Testy E2E Playwright (W4) ---
BASE_URL=https://localhost:8443
